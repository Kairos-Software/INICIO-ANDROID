# .env.example — plantilla SIN secretos (esta sí va al repo).
# Copiar como .env.local / .env.production / .env.test y completar.
DJANGO_ENV=local
DEBUG=True
SECRET_KEY=
# Para probar la app desde el celular, sumar la IP de la PC en la red (ej: 192.168.1.50)
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# --- Base de datos (PostgreSQL) ---
DB_NAME=proyecto_base
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Marca ---
NOMBRE_SISTEMA=Proyecto Base
NOMBRE_EMPRESA=Kairos Software

LANGUAGE_CODE=es-ar
TIME_ZONE=America/Argentina/Buenos_Aires
STATIC_URL=/static/
MEDIA_URL=/media/

# --- Mail (recuperación de contraseña) ---
# console = los mails se imprimen en la terminal (no se envían)
# smtp    = se envían de verdad (Gmail: usar "contraseña de aplicación")
EMAIL_BACKEND=console
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Seguridad del login (opcional) ---
LOGIN_INTENTOS_MAXIMOS=5
LOGIN_BLOQUEO_MINUTOS=15

# --- Mantenimiento y registros (opcional) ---
# True = el sistema muestra "Estamos actualizando" a todos menos a superusuarios
MODO_MANTENIMIENTO=False
ACTIVIDAD_DIAS_CONSERVAR=365
NOTIFICACIONES_DIAS_CONSERVAR=90

# --- API (apps de celular / TV) ---
# Días que dura la sesión de la app sin usarla
API_TOKEN_DIAS=30
